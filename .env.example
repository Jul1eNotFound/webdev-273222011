# Every environment variable your app needs, with harmless placeholder values.
# Copy to .env for local use. Real values go into your hosting provider's settings, never into git.
# In a codespace, put the secret ones in the repository's Codespaces secrets instead of a file.
PORT=3000
DATABASE_URL=postgres://user:password@host/dbname
# Signs the CSRF tokens on every form. At least 32 random characters; the server refuses to start otherwise.
SESSION_SECRET=change-me
PUBLIC_BASE_URL=http://localhost:3000

# A separate database for go test. Never point it at DATABASE_URL: the tests empty it.
TEST_DATABASE_URL=postgres://user:password@host/labwiz_test

# Passwords for the seeded demo accounts (go run ./cmd/seed). They are stored only as bcrypt hashes.
SEED_STUDENT_PASSWORD=change-me-student
SEED_STAFF_PASSWORD=change-me-staff

# Sign in with Google. Create an OAuth client at console.cloud.google.com and leave it in
# "Testing" mode with yourself as a test user: that is free and needs no app verification.
# Add every address you will sign in from as an authorized redirect URI, including your
# codespace's forwarded URL and your Render URL. Google requires https off localhost.
# The redirect URI is PUBLIC_BASE_URL + /auth/google/callback, e.g. http://localhost:3000/auth/google/callback.
# Leave both empty to hide the "Sign in with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The model feature (smart search). The key comes from console.anthropic.com and is read only by
# the Go backend; it never reaches the browser. The app still works without it (AC-27): the
# search box is hidden. MODEL_NAME defaults to claude-haiku-5-5.
ANTHROPIC_API_KEY=
MODEL_NAME=claude-haiku-5-5

# A sign-in session token for MCP clients, which send it as "Authorization: Bearer <token>" to /mcp.
# Get one with: go run ./cmd/mcptoken -email you@labwiz.test (it lasts 7 days). It grants exactly what
# that user may do, and nothing more, because the tools go through the same services as the HTTP API.
# The server does not read it; .vscode/mcp.json and your MCP client do.
MCP_TOKEN=
